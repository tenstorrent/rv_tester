load("//test/examples/common/dv:sim_test.bzl", "rv_tester_sim_test")

# ELF is rv64ima_zicsr (no F): its CRT emits no FP init, avoiding the
# unmapped-FP-write limitation (harness ties off rv_tester frd_*).
rv_tester_sim_test(
    name = "hello_world_cva6_verilator",
    elf = "//test/examples/common/testbins:hello_world.elf",
    tb = "//test/examples/cva6/dv/verilator:cva6_tb_verilator",
)

rv_tester_sim_test(
    name = "infinite_cva6_verilator",
    elf = "//test/examples/common/testbins:infinite.elf",
    plusargs = [
        "+nostandalone",
        "+eot=max_instr",
        "+max_instr=8",
    ],
    tb = "//test/examples/cva6/dv/verilator:cva6_tb_verilator",
)

test_suite(
    name = "all_smoke",
    tests = [
        ":infinite_cva6_verilator",
        ":hello_world_cva6_verilator",
    ],
)
