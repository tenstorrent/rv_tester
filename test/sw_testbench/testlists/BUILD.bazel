# Each smoke entry collapses to one sh_test that runs the pre-built
# sw_<N>c_tb_verilator binary against infinite.elf with the configured
# plusargs.
#
# infinite.elf is checked in as-is for now. TODO(open-source): replace with
# a real riscv32 toolchain cross-compile step once a public-friendly riscv
# toolchain is in the CI container.

exports_files(
    ["infinite.S", "nop.S", "infinite.elf", "sim.sh"],
    visibility = ["//visibility:public"],
)

# Sim binary, plusargs and runfiles shared by the 1-core tests.
SW_1C_ARGS = [
    "$(location //test/sw_testbench/verilator:sw_1c_tb_verilator)",
    "+load=$(location :infinite.elf)",
    "+memmap_json_path=$(location //test/sw_testbench:memmap.json)",
    "+whisper_json_path=$(location //test/sw_testbench:whisper.json)",
    "+nostandalone",
    "+eot=max_instr",
    "+max_instr=1",
]

SW_1C_DATA = [
    "//test/sw_testbench/verilator:sw_1c_tb_verilator",
    "//test/sw_testbench:memmap.json",
    "//test/sw_testbench:whisper.json",
    ":infinite.elf",
]

sh_test(
    name = "infinite_1c_verilator",
    srcs = ["//test/sw_testbench/testlists:sim.sh"],
    args = SW_1C_ARGS,
    data = SW_1C_DATA,
)

sh_test(
    name = "max_instr_tohost_1c_verilator",
    srcs = ["//test/sw_testbench/testlists:sim.sh"],
    args = [
        "$(location //test/sw_testbench/verilator:sw_1c_tb_verilator)",
        "+load=$(location :infinite.elf)",
        "+memmap_json_path=$(location //test/sw_testbench:memmap.json)",
        "+whisper_json_path=$(location //test/sw_testbench:whisper.json)",
        "+nostandalone",
        "+eot=tohost",
        "+max_instr=1",
    ],
    data = [
        "//test/sw_testbench/verilator:sw_1c_tb_verilator",
        "//test/sw_testbench:memmap.json",
        "//test/sw_testbench:whisper.json",
        ":infinite.elf",
    ],
    env = {"EXPECT_ERROR": "max_instr limit reached"},
    tags = ["no-valgrind"],
)

# Retire 100 lands after the pass condition but before cvm_done; only the RVFI drain checks it.
sh_test(
    name = "rvfi_drain_1c_verilator",
    srcs = ["//test/sw_testbench/testlists:sim.sh"],
    args = SW_1C_ARGS + [
        "+sw_tb_bad_retire=100",
    ],
    data = SW_1C_DATA,
    env = {
        "EXPECT_AFTER": "Pass condition detected",
        "EXPECT_ERROR": "Core Arch Checker Mismatch - PC ",
    },
    # The expected error exits nonzero, which hides valgrind's --error-exitcode.
    tags = ["no-valgrind"],
)

# Profile 1 differs from profile 0 on every clock, including TB_CLK and REF_CLK;
# top.sv checks each clock's period against the selected profile.
sh_test(
    name = "clk_profile_1c_verilator",
    srcs = ["//test/sw_testbench/testlists:sim.sh"],
    args = SW_1C_ARGS + [
        "+clk_profile=1",
    ],
    data = SW_1C_DATA,
)

sh_test(
    name = "clk_profile_out_of_range_1c_verilator",
    srcs = ["//test/sw_testbench/testlists:sim.sh"],
    args = SW_1C_ARGS + [
        "+clk_profile=99",
    ],
    data = SW_1C_DATA,
    env = {
        "EXPECT_ERROR": "Error: \\+clk_profile=99 is outside the clock profile table",
    },
    # The expected error exits nonzero, which hides valgrind's --error-exitcode.
    tags = ["no-valgrind"],
)

# TB_CLK clocks clock_mode and is itself switched. Profiles 2-6 share every
# frequency, so top.sv also fails if a switch disturbs a clock whose frequency
# did not change.
sh_test(
    name = "dyn_clk_switch_1c_verilator",
    srcs = ["//test/sw_testbench/testlists:sim.sh"],
    args = SW_1C_ARGS + [
        "+clk_profile=1",
        "+dyn_clk_switch",
        "+freq_switch_ncycles=20",
    ],
    data = SW_1C_DATA,
)

